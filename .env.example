# ============================================================
# Delilah Financial OS — Environment Configuration
#
# Copy this file to .env and replace placeholder values.
# NEVER commit .env or real credentials.
#
# Docker Compose supplies/overrides several container-local
# URLs and sandbox settings. See docker-compose.yml.
# ============================================================


# ────────────────────────────────────────────────────────────
# Discord
# ────────────────────────────────────────────────────────────

DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CHANNEL_ID=your_discord_channel_id_here


# ────────────────────────────────────────────────────────────
# Plaid
# ────────────────────────────────────────────────────────────

PLAID_CLIENT_ID=your_plaid_client_id
PLAID_SECRET=your_plaid_secret
PLAID_ACCESS_TOKENS=
PLAID_ENV=production
REDIRECT_URI=https://your-domain.example.com/


# ────────────────────────────────────────────────────────────
# LLM Provider
# ────────────────────────────────────────────────────────────

# Supported:
#   openai = OpenAI-compatible HTTP API
#   ollama = local Ollama
LLM_PROVIDER=ollama

# OpenAI-compatible API.
# Can point at OpenAI, OpenRouter, vLLM, or another compatible service.
OPENAI_URL=https://api.openai.com/v1/chat/completions
OPENAI_MODEL=
OPENAI_API_KEY=

# Local Ollama.
# Docker Compose overrides this to http://ollama:11434/api/chat.
OLLAMA_URL=http://localhost:11434/api/chat

ADVISOR_MODEL=your_model_here
MODEL_KEEP_ALIVE=30m


# ────────────────────────────────────────────────────────────
# OpenRouter
# ────────────────────────────────────────────────────────────

OPENROUTER_FREE_FIRST=0
OPENROUTER_MAX_FREE_ATTEMPTS=4
OPENROUTER_FREE_MODELS=
OPENROUTER_FREE_VISION_MODELS=
OPENROUTER_PAID_MODEL=openrouter/auto-beta


# ────────────────────────────────────────────────────────────
# Autonomous Wakeups
# ────────────────────────────────────────────────────────────

# By default wakeups inherit the normal LLM provider/model.
# Uncomment these to force wakeups to Ollama.

# WAKEUP_PROVIDER=ollama
# WAKEUP_MODEL=your_model_here


# ────────────────────────────────────────────────────────────
# Advisor Generation
# ────────────────────────────────────────────────────────────

ADVISOR_NUM_CTX=32768
ADVISOR_NUM_PREDICT=16384
ADVISOR_FINAL_NUM_PREDICT=8192
ADVISOR_TOOL_NUM_PREDICT=16384
ADVISOR_TURN_TIMEOUT_SECONDS=7200

CHAT_HISTORY_TURNS=100

CHAT_TEMPERATURE=0.42
CLASSIFY_TEMPERATURE=0.23
NUDGE_TEMPERATURE=0.5


# ────────────────────────────────────────────────────────────
# Tool Execution
# ────────────────────────────────────────────────────────────

MAX_TOOL_ROUNDS=30
MAX_TOOL_CALLS_PER_ROUND=30
MAX_TOTAL_TOOL_CALLS=500


# ────────────────────────────────────────────────────────────
# SearXNG / Web Search
# ────────────────────────────────────────────────────────────

# Docker Compose overrides this for Delilah.
SEARXNG_URL=http://localhost:8080/search

MAX_SEARCH_ENGINES_PER_QUERY=2
MAX_SEARCH_RESULTS_PER_ENGINE=5
MAX_SEARCH_UNIQUE_RESULTS=10

SEARCH_CONCURRENCY=2
SEARCH_SCRAPE_TOP_N=3
SEARCH_SCRAPE_MAX_CHARS=3500

MAX_SEARCH_ATTEMPTS_PER_ITEM=4

MAX_RESEARCH_FETCHES_PER_SEARCH=6
MAX_RESEARCH_CRAWL_PAGES_PER_ITEM=10
MAX_RESEARCH_CRAWL_DEPTH=2
MAX_RESEARCH_LEDGER_ITEMS=32
MAX_RESEARCH_LINKS_PER_PAGE=10
MAX_RESEARCH_QUEUE_SIZE=32

SEARCH_CACHE_TTL_SECONDS=300
RESEARCH_PAGE_CACHE_TTL_SECONDS=900

SEARCH_HTTP_TIMEOUT=45
SEARCH_TIME_RANGE=


# ────────────────────────────────────────────────────────────
# Jina Reader — Optional
# ────────────────────────────────────────────────────────────

# Leave blank to use direct HTTP / BeautifulSoup extraction.
JINA_API_KEY=


# ────────────────────────────────────────────────────────────
# Playwright
# ────────────────────────────────────────────────────────────

PLAYWRIGHT_ENABLED=0
PLAYWRIGHT_HEADLESS=1
PLAYWRIGHT_TIMEOUT_MS=18000
PLAYWRIGHT_WAIT_MS=900
PLAYWRIGHT_CONCURRENCY=2


# ────────────────────────────────────────────────────────────
# Image Processing
# ────────────────────────────────────────────────────────────

IMAGE_MAX_DIMENSION=1568
IMAGE_JPEG_QUALITY=85
MAX_IMAGES_PER_MESSAGE=4


# ────────────────────────────────────────────────────────────
# PDF Processing
# ────────────────────────────────────────────────────────────

PDF_MAX_PAGES=10
PDF_RENDER_SCALE=2.0


# ────────────────────────────────────────────────────────────
# Sandbox
# ────────────────────────────────────────────────────────────

# Docker Compose overrides the service URLs below.
SANDBOX_URL=http://localhost:8100/execute
SANDBOX_SHELL_URL=http://localhost:8100/shell
SANDBOX_INSTALL_URL=http://sandbox-installer:8100/install

SANDBOX_DEFAULT_TIMEOUT=90
SANDBOX_MAX_TIMEOUT=300
SANDBOX_MEMORY_LIMIT_MB=1536
SANDBOX_MAX_OUTPUT_CHARS=1000000000000000
SANDBOX_PACKAGES_DIR=/opt/packages

SANDBOX_HOST_PROJECT_DIR=/host/project
SANDBOX_HOST_DB_PATH=/host/data/finances.db

SANDBOX_INSTALL_TIMEOUT=120
SANDBOX_INSTALL_TIMEOUT_MAX=300

# REQUIRED.
# Generate a strong random value. This authenticates the bot to the
# sandbox API. NEVER expose this to model-executed Python/shell code.
SANDBOX_INTERNAL_TOKEN=generate_a_long_random_secret_here


# ────────────────────────────────────────────────────────────
# Bot / HTTP
# ────────────────────────────────────────────────────────────

HOSTNAME=delilah
BOT_PUBLIC_URL=
BOT_PUBLIC_PORT=8000
PORT_OFF=0

PYTHONUNBUFFERED=1


# ────────────────────────────────────────────────────────────
# Gmail
# ────────────────────────────────────────────────────────────

GMAIL_REDIRECT_URI=https://your-domain.example.com/gmail/callback


# ────────────────────────────────────────────────────────────
# Plaid Sync
# ────────────────────────────────────────────────────────────

ENABLE_PLAID_AUTOSYNC=false
LOW_BALANCE_THRESHOLD=150.00
PLAID_POLL_INTERVAL_SECONDS=300
PLAID_HOURLY_UPDATE_INTERVAL_SECONDS=3600


# ────────────────────────────────────────────────────────────
# General
# ────────────────────────────────────────────────────────────

TIMEZONE=America/New_York
