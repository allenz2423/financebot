# Delilah Financial OS — Environment Configuration
# Copy this file to .env and fill in your values. NEVER commit .env.
# All values are required unless marked [OPTIONAL].

# ============================================================
# Discord Bot
# ============================================================
# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# ID of the channel the bot listens in. Run `!status` in-channel to see it.
DISCORD_CHANNEL_ID=

# ============================================================
# LLM / Advisor
# ============================================================
# Ollama model tag, e.g. delilah-gemma-iq4nl:latest
ADVISOR_MODEL=

# Context window size for the advisor
ADVISOR_NUM_CTX=45000

# Max tokens for the final response
ADVISOR_FINAL_NUM_PREDICT=8192

# Max tokens per tool-call response
ADVISOR_TOOL_NUM_PREDICT=16384

# Max tokens for web/search/browser tool-call rounds. Keep this below
# ADVISOR_TOOL_NUM_PREDICT while allowing complex tool planning.
ADVISOR_WEB_TOOL_NUM_PREDICT=8192
ADVISOR_DEFAULT_TOOL_NUM_PREDICT=8192

# Sampling temperature for transaction classification (0 = deterministic)
CLASSIFY_TEMPERATURE=0.1

# Sampling temperatures for chat/advisor turns
# Higher temperatures prevent token collapse and improve dynamic tool planning
CLOUD_CHAT_TEMPERATURE=0.7
LOCAL_CHAT_TEMPERATURE=0.6
CHAT_TEMPERATURE=0.7
TOOL_TEMPERATURE=0.7
NUDGE_TEMPERATURE=0.3

# Agent scheduler/capacity defaults (restart Delilah after changing these).
# Worker count is an upper bound; each provider's concurrency is an independent
# hard ceiling. Keep both at 1 unless observed queue/inference metrics justify
# more. Inspect the rolling latency view with the bot-owner-only !scheduler.
# Provider names are runtime limiter keys: OpenRouter through the OpenAI-
# compatible LLM route is keyed as `openai` and uses OPENAI_CONCURRENCY;
# explicit `openrouter` calls use OPENROUTER_CONCURRENCY.
AGENT_MAX_WORKERS=1
AGENT_MAX_ACTIVE_TASKS_PER_OWNER=1
AGENT_MAX_QUEUE_PER_OWNER=8
OLLAMA_CONCURRENCY=1
OPENAI_CONCURRENCY=1
OPENROUTER_CONCURRENCY=1
KEV_CONCURRENCY=1

# Owner-controlled TTL for lessons reflected from verified successful tasks.
# 0 keeps these memories until the owner removes them; positive values expire
# after that many days (maximum 36500). Reflection uses the turn's configured
# provider: LLM_PROVIDER, or WAKEUP_PROVIDER for autonomous wakeups.
REFLECTION_MEMORY_TTL_DAYS=0

# Optional classifier-specific Ollama model. Defaults to ADVISOR_MODEL when
# unset, so the conversational advisor path is unchanged.
CLASSIFIER_MODEL=

# ============================================================
# KEV transaction classification (safe rollout)
# ============================================================
# Disabled by default. Enable shadow mode first; shadow predictions are stored
# for evaluation but do not change transactions.
KEV_TX_ENABLED=0
KEV_TX_SHADOW=0
KEV_TX_MODE=local
KEV_TX_MODEL=kev-latest
KEV_TX_LOCAL_URL=http://kev:8009/v1/systemone
KEV_TX_CLOUD_URL=
KEV_TX_CLOUD_API_KEY=
KEV_TX_BATCH_SIZE=8
KEV_TX_AUTO_ACCEPT_THRESHOLD=0.95
KEV_TX_REVIEW_THRESHOLD=0.80
KEV_TX_MIN_MARGIN=0.20
KEV_TX_FALLBACK_ENABLED=1
KEV_TX_TIMEOUT_SECONDS=30
KEV_TX_RETRIES=1
KEV_TX_MAX_CONTEXT_CHARS=2400
KEV_TX_MAX_HISTORY_ROWS=8
# Only uncertain/failed classifications use this bounded one-shot enrichment.
KEV_TX_QUICK_SEARCH_ENABLED=1
KEV_TX_QUICK_SEARCH_MAX_ITEMS=8
KEV_TX_QUICK_SEARCH_MAX_CHARS=1800

# [OPTIONAL] Max in-memory conversational turns kept per user (SESSION_HISTORY).
# Larger depth means deep old context stays retrievable (cache holds, hits pay
# nothing) at the cost of RAM. Old turns are trimmed FIFO past this depth.
# Default: 1000
SESSION_HISTORY_MAX_TURNS=1000

# [OPTIONAL] Background session-history compression. When a user's raw history
# grows past SESSION_COMPRESSION_MIN_ENTRIES, the oldest block past the
# keep-window is folded (in a background LLM call) into one dense digest and its
# raw entries are dropped from RAM (chat_history remains the raw source).
# Digests are injected ahead of the recent window so deep context stays usable
# without paying full token cost. Entries: 1 SESSION_HISTORY entry = 1 message;
# a typical turn is 2 entries (user + assistant).
SESSION_COMPRESSION_ENABLED=1
SESSION_COMPRESSION_MIN_ENTRIES=80
SESSION_COMPRESSION_BLOCK_ENTRIES=40
SESSION_COMPRESSION_KEEP_ENTRIES=60
SESSION_COMPRESSION_MAX_DIGESTS=6
SESSION_COMPRESSION_DIGEST_MAX_CHARS=1400
SESSION_COMPRESSION_INJECT_MAX_CHARS=3500

# ============================================================
# Web Search
# ============================================================
# Browserless is reachable to Delilah over the internal Docker network. Its
# host-published diagnostic port binds to loopback by default; change the bind
# address only if you intentionally want remote access and have added controls.
BROWSERLESS_HOST_BIND=127.0.0.1
BROWSERLESS_HOST_PORT=3002

# Jina AI API key for webpage content extraction
JINA_API_KEY=

# SearXNG search endpoint URL
SEARXNG_URL=http://searxng:8080/search
# Prefer OmniRoute's native free search gateway; fall back to SearXNG on error.
OMNIROUTE_SEARCH_ENABLED=1
OMNIROUTE_SEARCH_PROVIDER=duckduckgo-free

# Search tuning
MAX_SEARCH_ENGINES_PER_QUERY=4
MAX_SEARCH_RESULTS_PER_ENGINE=10
MAX_SEARCH_UNIQUE_RESULTS=20
SEARCH_CONCURRENCY=4
SEARCH_SCRAPE_TOP_N=6
SEARCH_HTTP_TIMEOUT=45
SEARCH_CACHE_TTL_SECONDS=300
MAX_SEARCH_ATTEMPTS_PER_ITEM=6
MAX_RESEARCH_CRAWL_PAGES_PER_ITEM=10
MAX_RESEARCH_CRAWL_DEPTH=2
MAX_RESEARCH_LINKS_PER_PAGE=10
MAX_RESEARCH_QUEUE_SIZE=32

# ============================================================
# Plaid Bank Integration
# ============================================================
# From https://dashboard.plaid.com/
PLAID_CLIENT_ID=
PLAID_SECRET=

# Plaid environment: development, sandbox, or production
PLAID_ENVIRONMENT=production

# ============================================================
# Gmail Integration
# ============================================================
# From https://console.cloud.google.com/
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8000/gmail/callback

# ============================================================
# Push Notifications (ntfy)
# ============================================================
# Your secret ntfy topic, generated by `!ntfysetup`
NTFY_TOPIC=

# ============================================================
# Sandbox
# ============================================================
# Shared secret between the bot and sandbox containers
SANDBOX_INTERNAL_TOKEN=

SANDBOX_DEFAULT_TIMEOUT=90
SANDBOX_MAX_TIMEOUT=14400
SANDBOX_MEMORY_LIMIT_MB=1536
SANDBOX_MAX_OUTPUT_CHARS=100000000

# ============================================================
# Playwright (optional, disabled by default)
# ============================================================
PLAYWRIGHT_ENABLED=0
PLAYWRIGHT_HEADLESS=1
PLAYWRIGHT_TIMEOUT_MS=18000
PLAYWRIGHT_WAIT_MS=900
PLAYWRIGHT_CONCURRENCY=2

# ============================================================
# Images / PDFs
# ============================================================
PDF_MAX_PAGES=10
PDF_RENDER_SCALE=2.0
IMAGE_MAX_DIMENSION=1568
IMAGE_JPEG_QUALITY=85
MAX_IMAGES_PER_MESSAGE=4

# ============================================================
# Financial Monitor
# ============================================================
# Seconds between monitor evaluation passes (default 30 min)
MONITOR_POLL_INTERVAL_SECONDS=1800
# ============================================================
# Speech-to-Text (voice memos)
# ============================================================
# Backend: "openai" (Whisper API) or "local" (faster-whisper on GPU)
STT_BACKEND=openai

# OpenAI Whisper path
OPENAI_API_KEY=
STT_OPENAI_MODEL=whisper-1

# Local GPU path (only used when STT_BACKEND=local)
STT_LOCAL_MODEL=base
STT_LOCAL_DEVICE=cuda
STT_LOCAL_COMPUTE=int8

# ============================================================
# Vector Embeddings (Qdrant semantic memory)
# ============================================================
# Embedding backend. "local"/"ollama" runs Ollama; "cloud"/"openai"/"openrouter"
# calls an HTTP embeddings API; "auto" tries local first and falls back to cloud.
EMBEDDING_BACKEND=local

# Local model tag in Ollama. Shipped default qwen3-embedding:0.6b (1024-dim,
# last-token pooled, instruction-tuned). Legacy nomic-embed-text[*] supported.
EMBEDDING_LOCAL_MODEL=qwen3-embedding:0.6b

# Ollama embeddings endpoint (defaults: http://ollama:11434/api/embed in Docker,
# http://localhost:11434/api/embed on the host).
# OLLAMA_EMBED_URL=http://ollama:11434/api/embed

# Cloud embedding model name (e.g. text-embedding-3-small).
# Requires OPENAI_API_KEY and a reachable embeddings endpoint.
EMBEDDING_CLOUD_MODEL=text-embedding-3-small

# [OPTIONAL] Explicit cloud embeddings endpoint. Default: derived from OPENAI_URL
# (OpenRouter -> https://openrouter.ai/api/v1/embeddings, native OpenAI ->
# https://api.openai.com/v1/embeddings, any other gateway -> /chat/completions
# swapped for /embeddings).
# EMBEDDING_CLOUD_URL=https://openrouter.ai/api/v1/embeddings

# Vector dimension — ANY positive integer equal to your model's output, and it
# MUST match any existing Qdrant collection (dense dims can't be resized in
# place; a mismatch raises loudly instead of queuing broken upserts).
# Known sizes: 1024 qwen3-embedding:0.6b | 768 nomic-embed-text | 1536 text-embedding-3-small.
# When unset it is derived from the configured model.
# EMBEDDING_VECTOR_SIZE=1024

# Target Qdrant collection name
QDRANT_COLLECTION=delilah_financial_memory

# How long the embedder stays loaded in Ollama VRAM (see EMBED_KEEP_ALIVE notes
# in code; short TTL keeps VRAM free for the advisor LLM).
# EMBED_KEEP_ALIVE=5m

# Retrieval universe filter (comma-separated domains searched by semantic RAG).
# gmail_message stays OUT by default: archived email is marketing-noise-heavy
# and is served by on-demand `search_gmail` keyword search instead of crowding
# claim retrieval. Set to "none"/"off"/"mixed" to search everything.
# SEMANTIC_RETRIEVAL_DOMAINS=world_model_claim,world_model_dossier,web_search_result

# [OPTIONAL] Query-side task instruction for instruction-tuned embedders
# (Qwen3). Tuned for personal-memory retrieval of this corpus; empty disables.
# EMBEDDING_QUERY_INSTRUCTION=Instruct: Given a user question about their life, possessions, finances and memories, retrieve the stored claims that answer it\nQuery: {q}

# How often the bot reconciles Qdrant with SQLite ground truth (re-index missed
# claims, delete stale points). Seconds, default 21600 (6 hours). Runs once at startup.
# VECTOR_RECONCILE_INTERVAL_SECONDS=21600

# ============================================================
# OmniRoute local LLM gateway (explicit model routing)
# ============================================================
# Routes OpenAI-compatible traffic (OPENAI_URL below) through the local
# Keep the selected model explicit; automatic aliases are rejected for
# tool-enabled requests.
# Required when the omniroute service is present in docker-compose.yml.
# OMNIROUTE_INITIAL_PASSWORD=change-me
# OMNIROUTE_JWT_SECRET=      # openssl rand -base64 48
# OMNIROUTE_API_KEY_SECRET=  # openssl rand -hex 32
# OMNIROUTE_STORAGE_ENCRYPTION_KEY=  # openssl rand -hex 32
# OMNIROUTE_MEMORY_MB=2048

# Point the OpenAI-compatible client at the gateway instead of upstream.
# OPENAI_MODEL is the gateway combo name ("delilah" = free-first routing).
# OPENAI_URL=http://omniroute:20128/v1/chat/completions
# OPENAI_MODEL=delilah
# OPENAI_API_KEY=sk-or-v1-...   # any non-empty key; gateway routes by combo

# Delilah-owned explicit route profiles. Use pipes so OpenRouter model IDs
# containing ":free" remain intact:
# NAME=TRANSPORT|MODEL|PROVIDER_ORDER...
# DELILAH_ROUTE_PROFILES=primary=openrouter|qwen/qwen3.8-27b:free|ProviderA
# DELILAH_ROUTE_PROFILE=primary
# OpenRouter provider order is sent with allow_fallbacks=false and
# require_parameters=true when a profile is active.

# ============================================================
# Kev typed decision sidecar
# ============================================================
# Kev is currently used as an internal typed routing/ambiguity layer. It never
# executes tools, grants broad authority, or replaces receipt-backed claims.
# KEV_MODE=local
# The API alias is kev-latest; the local sidecar is pinned to Kev-4B below.
# KEV_MODEL=kev-latest
# For a host-run Delilah process:
# KEV_LOCAL_URL=http://127.0.0.1:8009/v1/systemone
# For Docker Compose, use the service-network address instead:
# KEV_DOCKER_LOCAL_URL=http://kev:8009/v1/systemone
# KEV_CLOUD_URL=https://your-kev-deployment.example/v1/systemone
# KEV_CLOUD_API_KEY=
# KEV_TIMEOUT_SECONDS=3
# KEV_RUN=jaredpalmer/kev-4b
# KEV_REF=90990a5fac2995b9faa3190f7d437e84f2067768
# KEV_DEVICE=cpu  # use cuda only when the GPU has enough VRAM for Kev-4B
# Shadow is safe to enable before enforcement; both are off by default.
# KEV_SHADOW=0
# KEV_ENFORCING=0

# Semantic router rollout. Shadow records rankings only; live mode narrows the
# already-offered schema and dispatch gate, and fails open if retrieval fails.
# TOOL_ROUTER_SHADOW=0
# TOOL_ROUTER_SHADOW_SAMPLE=1
# TOOL_ROUTER_LIVE=0
# TOOL_ROUTER_LIVE_MIN_SCORE=0

# Model-generated memory persistence is disabled by default during the
# receipt/evidence migration.
# DELILAH_INLINE_MEMORY=0
# DELILAH_BACKGROUND_MEMORY=0

# OpenCode Zen (OpenAI-compatible). Obtain a Zen key from OpenCode and use
# OPENCODE_ZEN_ENABLED=1 to use big-pickle.
# OPENCODE_ZEN_MODEL=big-pickle
# OPENCODE_ZEN_URL=https://opencode.ai/zen/v1/chat/completions
# OPENCODE_ZEN_API_KEY=

# [OPTIONAL] Free-tier upstream provider keys. Composed into the omniroute
# container from these env vars; providers are wired into a combo via the
# OmniRoute dashboard (http://localhost:20128).
# DEEPSEEK_API_KEY=
# GEMINI_API_KEY=
# NVIDIA_API_KEY=
# JINA_API_KEY=
# GROQ_API_KEY=
# CLOUDFLARE_API_TOKEN=
# MISTRAL_API_KEY=

# ============================================================
# Concierge browser — B1 noVNC login intake (safe by default: OFF)
# ============================================================
# Master switch for the disposable headed-browser login intake
# (`!concierge login <domain>`). Off by default; with it off, no
# concierge-browser container is ever spawned and the flow refuses.
# ENABLE_CONCIERGE_BROWSER=0

# Browser GL acceleration knob (2.6): "cpu" is the portable default
# (SwiftShader), "igpu" uses the host DRM node and requires
# CONCIERGE_DRM_DEVICE/CONCIERGE_DRM_GID to be set ("ls /dev/dri").
# CONCIERGE_ACCEL=cpu
# CONCIERGE_DRM_DEVICE=/dev/dri/renderD129
# CONCIERGE_DRM_GID=105

# Image tag + loopback VNC bind used when spawning per-session containers.
# CONCIERGE_BROWSER_IMAGE=financebot-concierge-browser:latest
# CONCIERGE_VNC_BIND=127.0.0.1
