# Delilah Financial OS — Environment Configuration
# Copy this file to .env and fill in your values. NEVER commit .env.
# All values are required unless marked [OPTIONAL].

# ============================================================
# Discord Bot
# ============================================================
# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# ID of the channel the bot listens in. Run `!status` in-channel to see it.
DISCORD_CHANNEL_ID=

# ============================================================
# LLM / Advisor
# ============================================================
# Ollama model tag, e.g. delilah-gemma-iq4nl:latest
ADVISOR_MODEL=

# Context window size for the advisor
ADVISOR_NUM_CTX=45000

# Max tokens for the final response
ADVISOR_FINAL_NUM_PREDICT=8192

# Max tokens per tool-call response
ADVISOR_TOOL_NUM_PREDICT=16384

# Sampling temperature for transaction classification (0 = deterministic)
CLASSIFY_TEMPERATURE=0.23

# ============================================================
# Web Search
# ============================================================
# Jina AI API key for webpage content extraction
JINA_API_KEY=

# SearXNG search endpoint URL
SEARXNG_URL=http://searxng:8080/search

# Search tuning
MAX_SEARCH_ENGINES_PER_QUERY=4
MAX_SEARCH_RESULTS_PER_ENGINE=10
MAX_SEARCH_UNIQUE_RESULTS=20
SEARCH_CONCURRENCY=4
SEARCH_SCRAPE_TOP_N=6
SEARCH_HTTP_TIMEOUT=45
SEARCH_CACHE_TTL_SECONDS=300
MAX_SEARCH_ATTEMPTS_PER_ITEM=6
MAX_RESEARCH_CRAWL_PAGES_PER_ITEM=10
MAX_RESEARCH_CRAWL_DEPTH=2
MAX_RESEARCH_LINKS_PER_PAGE=10
MAX_RESEARCH_QUEUE_SIZE=32

# ============================================================
# Plaid Bank Integration
# ============================================================
# From https://dashboard.plaid.com/
PLAID_CLIENT_ID=
PLAID_SECRET=

# Plaid environment: development, sandbox, or production
PLAID_ENVIRONMENT=production

# ============================================================
# Gmail Integration
# ============================================================
# From https://console.cloud.google.com/
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8000/gmail/callback

# ============================================================
# Push Notifications (ntfy)
# ============================================================
# Your secret ntfy topic, generated by `!ntfysetup`
NTFY_TOPIC=

# ============================================================
# Sandbox
# ============================================================
# Shared secret between the bot and sandbox containers
SANDBOX_INTERNAL_TOKEN=

SANDBOX_DEFAULT_TIMEOUT=90
SANDBOX_MAX_TIMEOUT=300
SANDBOX_MEMORY_LIMIT_MB=1536
SANDBOX_MAX_OUTPUT_CHARS=100000000

# ============================================================
# Playwright (optional, disabled by default)
# ============================================================
PLAYWRIGHT_ENABLED=0
PLAYWRIGHT_HEADLESS=1
PLAYWRIGHT_TIMEOUT_MS=18000
PLAYWRIGHT_WAIT_MS=900
PLAYWRIGHT_CONCURRENCY=2

# ============================================================
# Images / PDFs
# ============================================================
PDF_MAX_PAGES=10
PDF_RENDER_SCALE=2.0
IMAGE_MAX_DIMENSION=1568
IMAGE_JPEG_QUALITY=85
MAX_IMAGES_PER_MESSAGE=4

# ============================================================
# Financial Monitor
# ============================================================
# Seconds between monitor evaluation passes (default 30 min)
MONITOR_POLL_INTERVAL_SECONDS=1800
# ============================================================
# Speech-to-Text (voice memos)
# ============================================================
# Backend: "openai" (Whisper API) or "local" (faster-whisper on GPU)
STT_BACKEND=openai

# OpenAI Whisper path
OPENAI_API_KEY=
STT_OPENAI_MODEL=whisper-1

# Local GPU path (only used when STT_BACKEND=local)
STT_LOCAL_MODEL=base
STT_LOCAL_DEVICE=cuda
STT_LOCAL_COMPUTE=int8

# ============================================================
# Vector Embeddings (Qdrant semantic memory)
# ============================================================
# Embedding backend. "local"/"ollama" runs Ollama; "cloud"/"openai"/"openrouter"
# calls an HTTP embeddings API; "auto" tries local first and falls back to cloud.
EMBEDDING_BACKEND=local

# Local model tag in Ollama. Shipped default qwen3-embedding:0.6b (1024-dim,
# last-token pooled, instruction-tuned). Legacy nomic-embed-text[*] supported.
EMBEDDING_LOCAL_MODEL=qwen3-embedding:0.6b

# Ollama embeddings endpoint (defaults: http://ollama:11434/api/embed in Docker,
# http://localhost:11434/api/embed on the host).
# OLLAMA_EMBED_URL=http://ollama:11434/api/embed

# Cloud embedding model name (e.g. text-embedding-3-small).
# Requires OPENAI_API_KEY and a reachable embeddings endpoint.
EMBEDDING_CLOUD_MODEL=text-embedding-3-small

# [OPTIONAL] Explicit cloud embeddings endpoint. Default: derived from OPENAI_URL
# (OpenRouter -> https://openrouter.ai/api/v1/embeddings, native OpenAI ->
# https://api.openai.com/v1/embeddings, any other gateway -> /chat/completions
# swapped for /embeddings).
# EMBEDDING_CLOUD_URL=https://openrouter.ai/api/v1/embeddings

# Vector dimension — ANY positive integer equal to your model's output, and it
# MUST match any existing Qdrant collection (dense dims can't be resized in
# place; a mismatch raises loudly instead of queuing broken upserts).
# Known sizes: 1024 qwen3-embedding:0.6b | 768 nomic-embed-text | 1536 text-embedding-3-small.
# When unset it is derived from the configured model.
# EMBEDDING_VECTOR_SIZE=1024

# Target Qdrant collection name
QDRANT_COLLECTION=delilah_financial_memory

# How long the embedder stays loaded in Ollama VRAM (see EMBED_KEEP_ALIVE notes
# in code; short TTL keeps VRAM free for the advisor LLM).
# EMBED_KEEP_ALIVE=5m

# Retrieval universe filter (comma-separated domains searched by semantic RAG).
# gmail_message stays OUT by default: archived email is marketing-noise-heavy
# and is served by on-demand `search_gmail` keyword search instead of crowding
# claim retrieval. Set to "none"/"off"/"mixed" to search everything.
# SEMANTIC_RETRIEVAL_DOMAINS=world_model_claim,world_model_dossier,web_search_result

# [OPTIONAL] Query-side task instruction for instruction-tuned embedders
# (Qwen3). Tuned for personal-memory retrieval of this corpus; empty disables.
# EMBEDDING_QUERY_INSTRUCTION=Instruct: Given a user question about their life, possessions, finances and memories, retrieve the stored claims that answer it\nQuery: {q}

# How often the bot reconciles Qdrant with SQLite ground truth (re-index missed
# claims, delete stale points). Seconds, default 21600 (6 hours). Runs once at startup.
# VECTOR_RECONCILE_INTERVAL_SECONDS=21600
