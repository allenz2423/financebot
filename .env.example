# Delilah Financial OS - Environment Configuration Example
# Copy this file to .env and fill in your actual values

# ============================================================
# SECURITY (REQUIRED)
# ============================================================
# Generate a secure key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here-change-in-production

# ============================================================
# DISCORD (REQUIRED)
# ============================================================
DISCORD_TOKEN=your-discord-bot-token-here
DISCORD_CHANNEL_ID=1539128341301301320

# ============================================================
# PLAID API (OPTIONAL - Required for bank sync)
# ============================================================
PLAID_CLIENT_ID=your-plaid-client-id
PLAID_SECRET=your-plaid-secret
PLAID_ENV=sandbox  # sandbox, development, or production
PLAID_ACCESS_TOKENS=access-token-1,access-token-2

# Low balance alert threshold
LOW_BALANCE_THRESHOLD=150.00

# Sync intervals (seconds)
PLAID_POLL_INTERVAL_SECONDS=300
PLAID_HOURLY_UPDATE_INTERVAL_SECONDS=3600

# ============================================================
# AI/LLM SERVICES
# ============================================================
OLLAMA_URL=http://localhost:11434/api/chat
ADVISOR_MODEL=gemma4:26b

# ============================================================
# SEARCH SERVICES
# ============================================================
SEARXNG_URL=http://localhost:8080/search

# Jina AI API for article extraction (optional)
JINA_API_KEY=

# Search configuration
SEARCH_CONCURRENCY=4
SEARCH_HTTP_TIMEOUT=45.0
SEARCH_CACHE_TTL_SECONDS=300

# ============================================================
# DATABASE
# ============================================================
DB_PATH=data/finances.db
DB_BUSY_TIMEOUT=10000

# ============================================================
# SANDBOX EXECUTION
# ============================================================
SANDBOX_URL=http://localhost:8001
SANDBOX_TIMEOUT_SECONDS=30
SANDBOX_MAX_CODE_LENGTH=50000

# ============================================================
# FEATURE FLAGS
# ============================================================
PLAYWRIGHT_ENABLED=1
PLAYWRIGHT_HEADLESS=1
PLAYWRIGHT_TIMEOUT_MS=18000
PLAYWRIGHT_WAIT_MS=900

# ============================================================
# RATE LIMITING
# ============================================================
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10

# ============================================================
# TIMEZONE
# ============================================================
TIMEZONE=America/New_York

# ============================================================
# ADVISOR CONFIGURATION
# ============================================================
MAX_TOOL_CALLS_PER_ROUND=0
MAX_TOTAL_TOOL_CALLS=100
CHAT_HISTORY_TURNS=100

# PDF processing
PDF_MAX_PAGES=6
PDF_RENDER_SCALE=2.0

# Image processing
IMAGE_MAX_DIMENSION=1568
