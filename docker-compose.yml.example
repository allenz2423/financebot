# Delilah / Financebot Docker Compose example
#
# Copy this file to docker-compose.yml and customize it for your environment:
#
#   cp docker-compose.yml.example docker-compose.yml
#
# Secrets and configuration belong in .env.
# See .env.example for the available environment variables.

networks:
  # Internal-only networks used by Delilah and the sandbox.
  financebot-internal:
    driver: bridge
    internal: true

  # Network used by the sandbox package installer to reach the PyPI proxy.
  sandbox-egress:
    driver: bridge
    internal: true

  # Outbound-only network for services that need to reach the public internet
  # (delilah, searxng, ollama, omniroute, browserless).
  egress:
    driver: bridge

  # Uncomment if you use an existing Nginx Proxy Manager installation
  # that provides this external Docker network.
  #
  # nginx-proxy-manager_default:
  #   external: true

volumes:
  ollama_data:
  sandbox-packages:
  sandbox-workspace:
  qdrant_data:
  omniroute-data:

services:
  delilah:
    build: .
    container_name: delilah_bot
    restart: unless-stopped

    volumes:
      - ./data:/app/data
      - sandbox-workspace:/workspace

    extra_hosts:
      - "host.docker.internal:host-gateway"

    networks:
      - default
      - financebot-internal
      - egress
      # Uncomment if using Nginx Proxy Manager:
      # - nginx-proxy-manager_default

    env_file:
      - .env

    hostname: "${HOSTNAME}"

    depends_on:
      - ollama
      - searxng
      - sandbox
      - stirling-pdf
      - qdrant
      - browserless
      - mcp-web-browser
      - omniroute

    environment:
      - OLLAMA_URL=http://ollama:11434/api/chat
      - SEARXNG_URL=http://searxng:8080/search
      - SANDBOX_URL=http://sandbox:8100/execute
      - SANDBOX_SHELL_URL=http://sandbox:8100/shell
      - SANDBOX_INSTALL_URL=http://sandbox-installer:8100/install
      - SANDBOX_WORKSPACE_READ_URL=http://sandbox:8100/workspace/read
      - STIRLING_PDF_URL=http://stirling-pdf:8080
      - QDRANT_URL=http://qdrant:6333
      - OLLAMA_EMBED_URL=http://ollama:11434/api/embed
      - BROWSERLESS_URL=http://browserless:3000
      - MCP_WEB_BROWSER_URL=http://mcp-web-browser:3000/sse
      - PYTHONUNBUFFERED=1

      # Search/research configuration.
      - SEARCH_CONCURRENCY=4
      - SEARCH_SCRAPE_TOP_N=6
      - SEARCH_HTTP_TIMEOUT=45
      - MAX_SEARCH_ENGINES_PER_QUERY=4
      - MAX_SEARCH_RESULTS_PER_ENGINE=10
      - MAX_SEARCH_UNIQUE_RESULTS=20
      - MAX_SEARCH_ATTEMPTS_PER_ITEM=6
      - MAX_RESEARCH_CRAWL_PAGES_PER_ITEM=10
      - MAX_RESEARCH_CRAWL_DEPTH=2
      - MAX_RESEARCH_LINKS_PER_PAGE=10
      - MAX_RESEARCH_QUEUE_SIZE=32
      - SEARCH_CACHE_TTL_SECONDS=300
      - RESEARCH_PAGE_CACHE_TTL_SECONDS=900

      # Playwright is disabled by default.
      # Uncomment/change these if you want browser-based page rendering.
      - PLAYWRIGHT_ENABLED=0
      - PLAYWRIGHT_HEADLESS=1
      - PLAYWRIGHT_TIMEOUT_MS=18000
      - PLAYWRIGHT_WAIT_MS=900
      - PLAYWRIGHT_CONCURRENCY=2

    ports:
      - "8000:8000"

  # Local PyPI proxy used by the sandbox package installer.
  #
  # The sandbox itself remains isolated from the public internet.
  pypi-proxy:
    image: ubuntu/squid:latest
    container_name: financebot-pypi-proxy
    restart: unless-stopped

    networks:
      - sandbox-egress
      - default

    volumes:
      - ./squid.conf:/etc/squid/squid.conf:ro

  # Disposable Python execution sandbox.
  #
  # This container is intentionally isolated and has no direct external
  # network access. It receives packages through sandbox-installer.
  sandbox:
    build:
      context: .
      dockerfile: ./sandbox/Dockerfile

    container_name: financebot-sandbox
    restart: unless-stopped

    networks:
      - default
      - financebot-internal

    environment:
      - SANDBOX_DEFAULT_TIMEOUT=90
      - SANDBOX_MAX_TIMEOUT=300
      - SANDBOX_MEMORY_LIMIT_MB=1536
      - SANDBOX_PACKAGES_DIR=/opt/packages
      - SANDBOX_HOST_PROJECT_DIR=/host/project
      - SANDBOX_HOST_DB_PATH=/host/data/finances.db

    volumes:
      - sandbox-packages:/opt/packages:ro

    mem_limit: 3072m
    cpus: 8.0
    pids_limit: 256
    read_only: true

    tmpfs:
      - /tmp:size=256m

    security_opt:
      - no-new-privileges:true

    cap_drop:
      - ALL

  # Installs Python packages into the shared sandbox package volume.
  #
  # This service has access to the PyPI proxy so packages can be installed,
  # while the actual sandbox remains network-isolated.
  sandbox-installer:
    build:
      context: .
      dockerfile: ./sandbox/Dockerfile

    container_name: financebot-sandbox-installer
    restart: unless-stopped

    networks:
      - default
      - sandbox-egress

    environment:
      - SANDBOX_PACKAGES_DIR=/opt/packages
      - SANDBOX_INSTALL_TIMEOUT=120
      - SANDBOX_INSTALL_TIMEOUT_MAX=300

    volumes:
      - sandbox-packages:/opt/packages

    mem_limit: 1024m
    cpus: 2.0
    read_only: true

    tmpfs:
      - /tmp:size=256m

    security_opt:
      - no-new-privileges:true

    cap_drop:
      - ALL

  # Local SearXNG instance used for web search.
  searxng:
    container_name: searxng
    image: searxng/searxng:latest

    ports:
      - "8080:8080"

    volumes:
      - ./searxng:/etc/searxng:rw

    environment:
      - SEARXNG_BASE_URL=http://localhost:8080/

    restart: unless-stopped

  # Optional local Ollama inference server.
  ollama:
    image: ollama/ollama
    restart: unless-stopped

    # Ollama is reachable by Delilah through the Docker network at:
    # http://ollama:11434/api/chat
    #
    # The port does NOT need to be exposed to the host for Delilah to use it.
    #
    # Uncomment if you want to access Ollama directly from the host or
    # another machine:
    #
    # ports:
    #   - "11434:11434"

    environment:
      - OLLAMA_MAX_LOADED_MODELS=2
      - OLLAMA_KEEP_ALIVE=-1
      - OLLAMA_NUM_PARALLEL=1
      - OLLAMA_CONTEXT_LENGTH=32768
      - OLLAMA_FLASH_ATTENTION=1
      - OLLAMA_KV_CACHE_TYPE=q4_0
      - OLLAMA_NUM_THREAD=16

    volumes:
      - ollama_data:/root/.ollama

    deploy:
      resources:
        reservations:
          devices:
            - driver: nvidia
              count: all
              capabilities: [gpu]

  # Qdrant vector database for semantic memory and financial snapshots
  qdrant:
    image: qdrant/qdrant:latest
    container_name: financebot-qdrant
    restart: unless-stopped
    volumes:
      - qdrant_data:/qdrant/storage
    networks:
      - financebot-internal
    ports:
      - "6333:6333"
    environment:
      - QDRANT__SERVICE__GRPC_PORT=6334
      - QDRANT__TELEMETRY_DISABLED=true

  # Stirling PDF — PDF manipulation & form processing
  stirling-pdf:
    image: frooodle/s-pdf:latest
    container_name: financebot-stirling-pdf
    restart: unless-stopped
    networks:
      - financebot-internal
    ports:
      - "8085:8080"
    environment:
      - DOCKER_ENABLE_SECURITY=false
      - SECURITY_ENABLELOGIN=false
      - INSTALL_BOOK_AND_ADVANCED_HTML_OPS=false
      - SYSTEM_DEFAULTLOCALE=en-US
    healthcheck:
      test: ["CMD-SHELL", "curl -f http://localhost:8080/api/v1/info/status || exit 1"]
      interval: 10s
      timeout: 5s
      retries: 5
      start_period: 30s

  # OmniRoute — local LLM gateway (free-tier-first routing + paid fallback).
  # Delilah's OPENAI_URL points at this service (see .env.example); the "delilah"
  # combo routes free-tier models first with openrouter/auto-beta as fallback.
  # Optional: remove this service and restore OPENAI_URL to the direct
  # OpenRouter endpoint to disable it.
  omniroute:
    image: diegosouzapw/omniroute:latest
    container_name: financebot-omniroute
    restart: unless-stopped
    environment:
      - PORT=20128
      - HOST=0.0.0.0
      - OMNIROUTE_PORT=20128
      - OMNIROUTE_DATA_DIR=/app/data
      - OMNIROUTE_ALLOW_DEFAULT_DATA_DIR=1
      - INITIAL_PASSWORD=${OMNIROUTE_INITIAL_PASSWORD}
      - JWT_SECRET=${OMNIROUTE_JWT_SECRET}
      - API_KEY_SECRET=${OMNIROUTE_API_KEY_SECRET}
      - STORAGE_ENCRYPTION_KEY=${OMNIROUTE_STORAGE_ENCRYPTION_KEY}
      - OMNIROUTE_MEMORY_MB=${OMNIROUTE_MEMORY_MB:-2048}
      - DEEPSEEK_API_KEY=${DEEPSEEK_API_KEY:-}
      - GEMINI_API_KEY=${GEMINI_API_KEY:-}
      - NVIDIA_API_KEY=${NVIDIA_API_KEY:-}
      - JINA_API_KEY=${JINA_API_KEY:-}
    volumes:
      - omniroute-data:/app/data
    networks:
      - financebot-internal
      - egress
    ports:
      - "20128:20128"

  # Browserless — headless Chromium sidecar for deep JS web scraping
  browserless:
    image: ghcr.io/browserless/chromium:latest
    container_name: financebot-browserless
    restart: unless-stopped
    networks:
      - financebot-internal
      - egress
    ports:
      - "3002:3000"
    environment:
      - CONCURRENT=5
      - QUEUED=10
      - TIMEOUT=60000
      - PREBOOT_CHROME=true
      - KEEP_ALIVE=true

  # MCP Web Browser — Model Context Protocol sidecar for browser tools
  mcp-web-browser:
    build:
      context: ./mcp-servers/web-browser
      dockerfile: Dockerfile
    container_name: financebot-mcp-web-browser
    restart: unless-stopped
    environment:
      - BROWSERLESS_URL=http://browserless:3000
      - PORT=3000
    networks:
      - financebot-internal
      - egress
    depends_on:
      - browserless

